#include <stddef.h>
#include <stdint.h>
{%- for header in copy.includes %}
#include {{ header }}
{%- endfor %}

#include "fir_{{ type.suffix }}.h"

/* The input history buffer holds the previous taps - 1 samples, followed by
 * space for a block of FILTER_BLOCK_SIZE new samples. Each block of input is
 * copied in after the history, filtered, and then the newest taps - 1 samples
 * are moved to the front to become the history for the next block */
{% include "filter_block.c.j2" %}

void fir_filter_{{ type.suffix }}({{ type.name }} *data_in, {{ type.name }} *data_out, struct fir_{{ type.suffix }}_t *filter,
				uint32_t length) {
	const uint32_t N = filter->taps;
	const uint32_t H = N - 1;
	{{ type.name }} *work = filter->in_buff;

	while (length > 0) {
		const uint32_t n = length < FILTER_BLOCK_SIZE ? length : FILTER_BLOCK_SIZE;

		filter_copy_{{ type.suffix }}(&work[H], data_in, n);
		filter_block_{{ type.suffix }}(filter->b, N, &work[H], 1, data_out, n);
		filter_shift_{{ type.suffix }}(work, &work[n], H);

		data_in += n;
		data_out += n;
		length -= n;
	}
}

uint32_t fir_decimate_{{ type.suffix }}({{ type.name }} *data_in, {{ type.name }} *data_out, struct fir_{{ type.suffix }}_t *filter,
				  uint32_t length, uint8_t decimation_rate) {
	const uint32_t N = filter->taps;
	const uint32_t H = N - 1;
	{{ type.name }} *work = filter->in_buff;
	/* Number of input samples until the next output is due, kept in the
	 * filter struct so the chunk length doesn't need to be a multiple of the
	 * decimation rate */
	uint32_t phase = filter->decimation_phase;
	uint32_t j = 0;

	while (length > 0) {
		const uint32_t n = length < FILTER_BLOCK_SIZE ? length : FILTER_BLOCK_SIZE;
		/* Only calculate the filter against the output values to avoid
		 * unnecessary computation */
		const uint32_t n_out =
			phase < n ? (n - phase + decimation_rate - 1) / decimation_rate : 0;

		filter_copy_{{ type.suffix }}(&work[H], data_in, n);
		filter_block_{{ type.suffix }}(filter->b, N, &work[H + phase], decimation_rate,
							 &data_out[j], n_out);
		filter_shift_{{ type.suffix }}(work, &work[n], H);

		/* Work out where the next output falls relative to the next block */
		phase = phase + n_out * decimation_rate - n;
		j += n_out;
		data_in += n;
		length -= n;
	}
	filter->decimation_phase = (uint8_t)phase;
	return j;
}
