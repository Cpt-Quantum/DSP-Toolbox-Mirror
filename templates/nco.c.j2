#include "nco_{{ type.suffix }}.h"
#include <stddef.h>
{%- if nco.sine == "libm" %}
#include <math.h>
{%- endif %}
{%- set W = wave.type %}
{%- set L = wave.literal_suffix %}
{#- Type of a sample before it is converted to the output, with any rounding
    and saturation #}
{%- set V = "int64_t" if nco.fixed else W %}

/* Phase of a quarter and a half of a period */
#define NCO_QUARTER_{{ type.suffix | upper }} UINT64_C(0x4000000000000000)
#define NCO_HALF_{{ type.suffix | upper }} UINT64_C(0x8000000000000000)

/* Converts a number of periods to a phase, keeping the fraction of a period
 * and rounding it to the nearest step. The settings are converted in double,
 * so the frequency resolution is the same for every type, without needing
 * the maths library */
static uint64_t nco_phase_from_periods_{{ type.suffix }}(double periods) {
	/* Every double from 2^52 up is a whole number of periods. This also
	 * catches NaN */
	if (!(periods > -4503599627370496.0 && periods < 4503599627370496.0)) {
		return 0;
	}
	/* Negative values are converted as positive and then negated, as the
	 * fraction of a period of a small negative value, e.g. 1 - 1e-6, isn't
	 * exact in double. Removing the whole periods and scaling by 2^64 are
	 * exact, so only the final rounding loses anything */
	const bool negative = periods < 0.0;
	const double magnitude = negative ? -periods : periods;
	const double scaled = (magnitude - (double)(int64_t)magnitude) * 18446744073709551616.0;
	uint64_t phase = (uint64_t)scaled;
	if (scaled - (double)phase >= 0.5) {
		phase++;
	}
	return negative ? (uint64_t)0 - phase : phase;
}

{%- if nco.fixed %}

/* {{ type.name }} uses integer maths only for each sample. The shapes are in Q30, so
 * 1.0 is NCO_ONE, and the amplitude and offset are integers */
#define NCO_ONE_{{ type.suffix | upper }} INT32_C(0x40000000)
#define NCO_ROUND_{{ type.suffix | upper }} INT64_C(0x20000000)

/* round(sin(pi / 2 * i / {{ nco.table_size }}) * 2^30) for i from 0 to {{ nco.table_size }}, generated by
 * generate_sources.py. The extra entry past the end is only read with an
 * interpolation fraction of 0, at the peak */
static const int32_t nco_sine_table_{{ type.suffix }}[{{ nco.table_size + 2 }}] = {
{%- for entry in nco.table_entries %}
	{{ entry }},
{%- endfor %}
};

/* sin(2 pi phase / 2^64) in Q30, interpolated from the quarter wave table */
static inline int32_t nco_sin_{{ type.suffix }}(uint64_t phase) {
	const uint32_t quadrant = (uint32_t)(phase >> 62);
	uint64_t position = phase & (NCO_QUARTER_{{ type.suffix | upper }} - 1);
	/* The second and fourth quarters run back down the table */
	if (quadrant & 1) {
		position = NCO_QUARTER_{{ type.suffix | upper }} - position;
	}
	const uint32_t index = (uint32_t)(position >> {{ 62 - nco.table_bits }});
	const int64_t fraction = (int64_t)((position >> {{ nco.frac_shift }}) & {{ nco.frac_mask }});
	const int32_t below = nco_sine_table_{{ type.suffix }}[index];
	/* The table rises through the quarter, so the step is only negative past
	 * the peak, where the fraction is 0, and the shift is of a positive value */
	const int64_t step = (int64_t)nco_sine_table_{{ type.suffix }}[index + 1] - below;
	const int32_t value = below + (int32_t)((step * fraction + {{ nco.frac_half }}) >> {{ nco.frac_bits }});
	return (quadrant & 2) ? -value : value;
}

/* The wave at phase in Q30, before the amplitude and offset are applied. The
 * shapes match waveform_add_superposition_{{ type.suffix }}() */
static inline int32_t nco_shape_{{ type.suffix }}(const nco_{{ type.suffix }}_t *nco, uint64_t phase) {
	switch (nco->function_type) {
	case FUNCTION_SINE:
		return nco_sin_{{ type.suffix }}(phase);
	case FUNCTION_COS:
	case FUNCTION_CHIRP:
		return nco_sin_{{ type.suffix }}(phase + NCO_QUARTER_{{ type.suffix | upper }});
	case FUNCTION_SQUARE:
		return (nco->duty_always_high || phase < nco->duty_threshold) ? NCO_ONE_{{ type.suffix | upper }} : -NCO_ONE_{{ type.suffix | upper }};
	case FUNCTION_TRIANGLE: {
		/* 4 * fraction in Q30 is the top 32 bits of the phase */
		const int64_t rise = (int64_t)(phase >> 32);
		return (int32_t)(phase < NCO_HALF_{{ type.suffix | upper }} ? rise - NCO_ONE_{{ type.suffix | upper }} : 3 * (int64_t)NCO_ONE_{{ type.suffix | upper }} - rise);
	}
	case FUNCTION_SAWTOOTH:
		return (int32_t)((int64_t)(phase >> 33) - NCO_ONE_{{ type.suffix | upper }});
	default:
		return 0;
	}
}
{%- if type.name == "int32_t" %}

/* The sample at phase, offset + amplitude * shape rounded to the nearest
 * integer (halves away from zero), before saturating. This is exact in
 * int64_t, as the amplitude and offset are limited to +/- 2^32 */
static inline int64_t nco_value_{{ type.suffix }}(const nco_{{ type.suffix }}_t *nco, uint64_t phase) {
	const int64_t product = nco->amplitude * nco_shape_{{ type.suffix }}(nco, phase);
	const int64_t scaled = product >= 0 ? (product + NCO_ROUND_{{ type.suffix | upper }}) >> 30 : -((-product + NCO_ROUND_{{ type.suffix | upper }}) >> 30);
	return nco->offset + scaled;
}

/* value saturated to int32_t, and x + value */
static inline int32_t nco_saturate_{{ type.suffix }}(int64_t value) {
	return value > INT32_MAX ? INT32_MAX : value < INT32_MIN ? INT32_MIN : (int32_t)value;
}
static inline int32_t nco_add_{{ type.suffix }}_value(int32_t x, int64_t value) {
	return nco_saturate_{{ type.suffix }}((int64_t)x + value);
}
{%- else %}

/* The int64_t with the two's complement bits of value, without the
 * implementation defined conversion of values above INT64_MAX */
static inline int64_t nco_from_unsigned_{{ type.suffix }}(uint64_t value) {
	return value <= (uint64_t)INT64_MAX ? (int64_t)value : -(int64_t)~value - 1;
}

/* x plus or minus magnitude, saturated */
static inline int64_t nco_add_magnitude_{{ type.suffix }}(int64_t x, bool negative, uint64_t magnitude) {
	if (negative) {
		if (magnitude > (uint64_t)x - (uint64_t)INT64_MIN) {
			return INT64_MIN;
		}
		return nco_from_unsigned_{{ type.suffix }}((uint64_t)x - magnitude);
	}
	if (magnitude > (uint64_t)INT64_MAX - (uint64_t)x) {
		return INT64_MAX;
	}
	return nco_from_unsigned_{{ type.suffix }}((uint64_t)x + magnitude);
}

/* The sample at phase, offset + amplitude * shape rounded to the nearest
 * integer (halves away from zero) and saturated. The product needs up to 93
 * bits, so it is formed from the two 32 bit halves of the amplitude */
static inline int64_t nco_value_{{ type.suffix }}(const nco_{{ type.suffix }}_t *nco, uint64_t phase) {
	const int32_t shape = nco_shape_{{ type.suffix }}(nco, phase);
	const bool negative = (nco->amplitude < 0) != (shape < 0);
	const uint64_t amplitude = nco->amplitude < 0 ? (uint64_t)0 - (uint64_t)nco->amplitude : (uint64_t)nco->amplitude;
	const uint64_t size = (uint64_t)(shape < 0 ? -(int64_t)shape : (int64_t)shape);
	/* The high half is shifted up by 32 and down by 30, which is exact, so
	 * only the low half is rounded. At most 2^63 + 2^32, so it fits */
	const uint64_t high = (amplitude >> 32) * size;
	const uint64_t low = (amplitude & UINT64_C(0xFFFFFFFF)) * size;
	const uint64_t magnitude = (high << 2) + ((low + (uint64_t)NCO_ROUND_{{ type.suffix | upper }}) >> 30);
	return nco_add_magnitude_{{ type.suffix }}(nco->offset, negative, magnitude);
}

/* x + value, saturated */
static inline int64_t nco_add_{{ type.suffix }}_value(int64_t x, int64_t value) {
	return nco_add_magnitude_{{ type.suffix }}(x, value < 0, value < 0 ? (uint64_t)0 - (uint64_t)value : (uint64_t)value);
}
{%- endif %}

/* Rounds a setting to the nearest integer (halves away from zero),
{%- if type.name == "int32_t" %} limited to
 * +/- 2^32 so the sample maths can't overflow
{%- else %} saturated
{%- endif %}. NaN gives 0 */
static int64_t nco_round_setting_{{ type.suffix }}(double value) {
	if (value != value) {
		return 0;
	}
{%- if type.name == "int32_t" %}
	if (value >= 4294967296.0) {
		return INT64_C(4294967296);
	}
	if (value <= -4294967296.0) {
		return -INT64_C(4294967296);
	}
{%- else %}
	if (value >= 9223372036854775808.0) {
		return INT64_MAX;
	}
	if (value < -9223372036854775808.0) {
		return INT64_MIN;
	}
{%- endif %}
	/* The part removed by truncating is exact, and only non zero well inside
	 * the range */
	int64_t whole = (int64_t)value;
	const double rest = value - (double)whole;
	if (rest >= 0.5) {
		whole++;
	} else if (rest <= -0.5) {
		whole--;
	}
	return whole;
}
{%- else %}

/* Fraction of a period of phase, from 0 up to 1, exact in {{ W }} */
static inline {{ W }} nco_fraction_{{ type.suffix }}(uint64_t phase) {
{%- if W == "float" %}
	return (float)(uint32_t)(phase >> 40) * 5.9604644775390625e-08f;
{%- else %}
	return (double)(phase >> 11) * 1.1102230246251565404e-16;
{%- endif %}
}
{%- if nco.sine == "table" %}

/* sin(pi / 2 * i / {{ nco.table_size }}) for i from 0 to {{ nco.table_size }}, generated by
 * generate_sources.py. The extra entry past the end is only read with an
 * interpolation fraction of 0, at the peak */
static const {{ W }} nco_sine_table_{{ type.suffix }}[{{ nco.table_size + 2 }}] = {
{%- for entry in nco.table_entries %}
	{{ entry }},
{%- endfor %}
};

/* sin(2 pi phase / 2^64), interpolated from the quarter wave table */
static inline {{ W }} nco_sin_{{ type.suffix }}(uint64_t phase) {
	const uint32_t quadrant = (uint32_t)(phase >> 62);
	uint64_t position = phase & (NCO_QUARTER_{{ type.suffix | upper }} - 1);
	/* The second and fourth quarters run back down the table */
	if (quadrant & 1) {
		position = NCO_QUARTER_{{ type.suffix | upper }} - position;
	}
	const uint32_t index = (uint32_t)(position >> {{ 62 - nco.table_bits }});
	const {{ W }} fraction = ({{ W }})({{ "uint32_t" if W == "float" else "uint64_t" }})((position >> {{ nco.frac_shift }}) & {{ nco.frac_mask }}) * {{ nco.frac_scale }};
	const {{ W }} below = nco_sine_table_{{ type.suffix }}[index];
	const {{ W }} value = below + fraction * (nco_sine_table_{{ type.suffix }}[index + 1] - below);
	return (quadrant & 2) ? -value : value;
}
{%- else %}

/* sin(2 pi phase / 2^64). The angle is reduced to the first quarter of a
 * period, so it is accurate to the precision of {{ W }} */
static inline {{ W }} nco_sin_{{ type.suffix }}(uint64_t phase) {
	const {{ W }} angle = 1.57079632679489661923{{ L }} * nco_fraction_{{ type.suffix }}(phase << 2);
	switch (phase >> 62) {
	case 0:
		return sin{{ wave.math_suffix }}(angle);
	case 1:
		return cos{{ wave.math_suffix }}(angle);
	case 2:
		return -sin{{ wave.math_suffix }}(angle);
	default:
		return -cos{{ wave.math_suffix }}(angle);
	}
}
{%- endif %}

/* The wave at phase, before the amplitude and offset are applied. The shapes
 * match waveform_add_superposition_{{ type.suffix }}() */
static inline {{ W }} nco_shape_{{ type.suffix }}(const nco_{{ type.suffix }}_t *nco, uint64_t phase) {
	switch (nco->function_type) {
	case FUNCTION_SINE:
		return nco_sin_{{ type.suffix }}(phase);
	case FUNCTION_COS:
	case FUNCTION_CHIRP:
		return nco_sin_{{ type.suffix }}(phase + NCO_QUARTER_{{ type.suffix | upper }});
	case FUNCTION_SQUARE:
		return (nco->duty_always_high || phase < nco->duty_threshold) ? 1.0{{ L }} : -1.0{{ L }};
	case FUNCTION_TRIANGLE: {
		const {{ W }} fraction = nco_fraction_{{ type.suffix }}(phase);
		return phase < NCO_HALF_{{ type.suffix | upper }} ? 4.0{{ L }} * fraction - 1.0{{ L }} : 3.0{{ L }} - 4.0{{ L }} * fraction;
	}
	case FUNCTION_SAWTOOTH:
		return 2.0{{ L }} * nco_fraction_{{ type.suffix }}(phase) - 1.0{{ L }};
	default:
		return 0.0{{ L }};
	}
}

/* The sample at phase */
static inline {{ W }} nco_value_{{ type.suffix }}(const nco_{{ type.suffix }}_t *nco, uint64_t phase) {
	return nco->offset + nco->amplitude * nco_shape_{{ type.suffix }}(nco, phase);
}

{%- endif %}

/* Moves on to the next sample */
static inline void nco_advance_{{ type.suffix }}(nco_{{ type.suffix }}_t *nco) {
	nco->phase += nco->step;
	nco->step += nco->sweep_step;
}
{%- if type.fixed_point and not nco.fixed %}

/* x + value, rounded to the nearest integer (halves away from zero) and
 * saturated, the same as waveform_add_sample_{{ type.suffix }}() but without the maths
 * library. NaN adds nothing */
static inline {{ type.name }} nco_add_sample_{{ type.suffix }}({{ type.name }} x, {{ W }} value) {
	if (value != value) {
		return x;
	}
{%- if type.name == "int32_t" %}
	/* Limited to +/- 2^32 first, so the sum can't overflow int64_t */
	int64_t step;
	if (value >= 4294967296.0{{ L }}) {
		step = INT64_C(4294967296);
	} else if (value <= -4294967296.0{{ L }}) {
		step = -INT64_C(4294967296);
	} else {
		/* The part removed by truncating is exact in {{ W }} */
		step = (int64_t)value;
		const {{ W }} rest = value - ({{ W }})step;
		if (rest >= 0.5{{ L }}) {
			step++;
		} else if (rest <= -0.5{{ L }}) {
			step--;
		}
	}
	const int64_t sum = (int64_t)x + step;
	return sum > INT32_MAX ? INT32_MAX : sum < INT32_MIN ? INT32_MIN : (int32_t)sum;
{%- else %}
	/* 2^63 is exact in {{ W }}, and the smallest value that doesn't fit */
	int64_t step;
	if (value >= 9223372036854775808.0{{ L }}) {
		step = INT64_MAX;
	} else if (value < -9223372036854775808.0{{ L }}) {
		step = INT64_MIN;
	} else {
		/* The part removed by truncating is exact in {{ W }}, and is only non
		 * zero well inside the range, so the rounding can't overflow */
		step = (int64_t)value;
		const {{ W }} rest = value - ({{ W }})step;
		if (rest >= 0.5{{ L }}) {
			step++;
		} else if (rest <= -0.5{{ L }}) {
			step--;
		}
	}
	if (step > 0 && x > INT64_MAX - step) {
		return INT64_MAX;
	}
	if (step < 0 && x < INT64_MIN - step) {
		return INT64_MIN;
	}
	return x + step;
{%- endif %}
}
{%- endif %}
{#- Converts the {{ W }} value to a sample, or adds it to target #}
{%- macro to_sample(value) -%}
{%- if nco.fixed and type.name == "int32_t" -%}
nco_saturate_{{ type.suffix }}({{ value }})
{%- elif nco.fixed -%}
{{ value }}
{%- elif type.fixed_point -%}
nco_add_sample_{{ type.suffix }}(0, {{ value }})
{%- else -%}
{{ value }}
{%- endif -%}
{%- endmacro %}
{%- macro add_to(target, value) -%}
{%- if nco.fixed -%}
{{ target }} = nco_add_{{ type.suffix }}_value({{ target }}, {{ value }})
{%- elif type.fixed_point -%}
{{ target }} = nco_add_sample_{{ type.suffix }}({{ target }}, {{ value }})
{%- else -%}
{{ target }} = {{ target }} + {{ value }}
{%- endif -%}
{%- endmacro %}

NCO_STATUS_E nco_init_{{ type.suffix }}(nco_{{ type.suffix }}_t *nco, wave_properties_{{ type.suffix }}_t wave_properties, uint32_t sample_rate) {
	if (nco == NULL) {
		return NCO_ERR_NULL_POINTER;
	}
	if (sample_rate == 0) {
		return NCO_ERR_INVALID_SAMPLE_RATE;
	}
	switch (wave_properties.function_type) {
	case FUNCTION_SINE:
	case FUNCTION_COS:
	case FUNCTION_SQUARE:
	case FUNCTION_TRIANGLE:
	case FUNCTION_SAWTOOTH:
	case FUNCTION_CHIRP:
		break;
	default:
		return NCO_ERR_INVALID_FUNCTION;
	}

	nco->function_type = wave_properties.function_type;
{%- if nco.fixed %}
	nco->amplitude = nco_round_setting_{{ type.suffix }}((double)wave_properties.amplitude);
	nco->offset = nco_round_setting_{{ type.suffix }}((double)wave_properties.offset);
{%- else %}
	nco->amplitude = wave_properties.amplitude;
	nco->offset = wave_properties.offset;
{%- endif %}
	nco->sample_rate = sample_rate;

	/* A duty cycle of 0 selects 0.5, as for the block generator */
	const double duty = wave_properties.duty_cycle == 0 ? 0.5 : (double)wave_properties.duty_cycle;
	nco->duty_always_high = duty >= 1.0;
	nco->duty_threshold = (duty > 0.0 && duty < 1.0) ? nco_phase_from_periods_{{ type.suffix }}(duty) : 0;

	nco->phase = nco_phase_from_periods_{{ type.suffix }}((double)wave_properties.phase);
	nco->sweep_step = 0;
	nco->sweep_half = 0;
	nco_set_frequency_{{ type.suffix }}(nco, wave_properties.frequency);
	if (wave_properties.function_type == FUNCTION_CHIRP) {
		nco_set_sweep_{{ type.suffix }}(nco, wave_properties.sweep_rate);
	}
	return NCO_OK;
}

void nco_set_frequency_{{ type.suffix }}(nco_{{ type.suffix }}_t *nco, wave_math_{{ type.suffix }}_t frequency) {
	/* During a sweep the step is half a sweep step ahead of the frequency, so
	 * the phase is the integral of the frequency, matching a continuous sweep
	 * at every sample rather than lagging by half a sample per sample */
	nco->step = nco_phase_from_periods_{{ type.suffix }}((double)frequency / (double)nco->sample_rate) + nco->sweep_half;
}

void nco_set_sweep_{{ type.suffix }}(nco_{{ type.suffix }}_t *nco, wave_math_{{ type.suffix }}_t sweep_rate) {
	/* The change in frequency each sample, in periods per sample */
	const double rate = (double)sweep_rate / ((double)nco->sample_rate * (double)nco->sample_rate);
	const uint64_t half = nco_phase_from_periods_{{ type.suffix }}(0.5 * rate);
	nco->step = nco->step - nco->sweep_half + half;
	nco->sweep_step = nco_phase_from_periods_{{ type.suffix }}(rate);
	nco->sweep_half = half;
}

void nco_set_phase_{{ type.suffix }}(nco_{{ type.suffix }}_t *nco, wave_math_{{ type.suffix }}_t phase) {
	nco->phase = nco_phase_from_periods_{{ type.suffix }}((double)phase);
}

{{ type.name }} nco_sample_{{ type.suffix }}(nco_{{ type.suffix }}_t *nco) {
	const {{ V }} value = nco_value_{{ type.suffix }}(nco, nco->phase);
	nco_advance_{{ type.suffix }}(nco);
	return {{ to_sample("value") }};
}

void nco_generate_{{ type.suffix }}(nco_{{ type.suffix }}_t *nco, {{ type.name }} *x, uint32_t length) {
	for (uint32_t i = 0; i < length; i++) {
		x[i] = nco_sample_{{ type.suffix }}(nco);
	}
}

void nco_add_{{ type.suffix }}(nco_{{ type.suffix }}_t *nco, {{ type.name }} *x, uint32_t length) {
	for (uint32_t i = 0; i < length; i++) {
		{{ add_to("x[i]", "nco_value_" ~ type.suffix ~ "(nco, nco->phase)") }};
		nco_advance_{{ type.suffix }}(nco);
	}
}

complex_{{ type.suffix }}_t nco_sample_complex_{{ type.suffix }}(nco_{{ type.suffix }}_t *nco) {
	const {{ V }} real = nco_value_{{ type.suffix }}(nco, nco->phase);
	const {{ V }} imag = nco_value_{{ type.suffix }}(nco, nco->phase - NCO_QUARTER_{{ type.suffix | upper }});
	nco_advance_{{ type.suffix }}(nco);
	complex_{{ type.suffix }}_t sample = { {{- to_sample("real") }}, {{ to_sample("imag") -}} };
	return sample;
}

void nco_generate_complex_{{ type.suffix }}(nco_{{ type.suffix }}_t *nco, complex_{{ type.suffix }}_t *x, uint32_t length) {
	for (uint32_t i = 0; i < length; i++) {
		x[i] = nco_sample_complex_{{ type.suffix }}(nco);
	}
}

void nco_add_complex_{{ type.suffix }}(nco_{{ type.suffix }}_t *nco, complex_{{ type.suffix }}_t *x, uint32_t length) {
	for (uint32_t i = 0; i < length; i++) {
		{{ add_to("x[i].real", "nco_value_" ~ type.suffix ~ "(nco, nco->phase)") }};
		{{ add_to("x[i].imag", "nco_value_" ~ type.suffix ~ "(nco, nco->phase - NCO_QUARTER_" ~ (type.suffix | upper) ~ ")") }};
		nco_advance_{{ type.suffix }}(nco);
	}
}
