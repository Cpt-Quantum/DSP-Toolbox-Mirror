#include "iir_{{ type.suffix }}.h"

#include <stddef.h>
#include <stdint.h>
{%- for header in copy.includes %}
#include {{ header }}
{%- endfor %}

/* The input and output history buffers each hold the previous taps - 1
 * samples, followed by space for a block of FILTER_BLOCK_SIZE new samples */
{% include "filter_block.c.j2" %}

void iir_filter_{{ type.suffix }}({{ type.name }} *data_in, {{ type.name }} *data_out, struct iir_{{ type.suffix }}_t *filter,
				uint32_t length) {
	const uint32_t N = filter->taps;
	const uint32_t H = N - 1;
	{{ type.name }} *in_work = filter->in_buff;
	{{ type.name }} *out_work = filter->out_buff;

	while (length > 0) {
		const uint32_t n = length < FILTER_BLOCK_SIZE ? length : FILTER_BLOCK_SIZE;

		/* The feedforward terms don't depend on previous outputs, so are
		 * calculated for the whole block at once into data_out */
		filter_copy_{{ type.suffix }}(&in_work[H], data_in, n);
		filter_block_{{ type.suffix }}(filter->b, N, &in_work[H], 1, data_out, n);

		/* The feedback terms are recursive, so are calculated per sample */
		for (uint32_t c = 0; c < n; c++) {
			{{ type.name }} acc = data_out[c];
			const {{ type.name }} *y = &out_work[H + c];
			for (uint32_t i = 1; i < N; i++) {
				acc = acc - (filter->a[i] * *(y - i));
			}
			acc = acc / filter->a[0];
			out_work[H + c] = acc;
			data_out[c] = acc;
		}

		filter_shift_{{ type.suffix }}(in_work, &in_work[n], H);
		filter_shift_{{ type.suffix }}(out_work, &out_work[n], H);

		data_in += n;
		data_out += n;
		length -= n;
	}
}

/* Direct Form I biquad section, with the previous two inputs and outputs held
 * in shift registers. The input is read before the output is written so the
 * section can be run in place (data_in == data_out) */
static void biquad_section_filter_{{ type.suffix }}({{ type.name }} *data_in, {{ type.name }} *data_out,
						   struct biquad_section_{{ type.suffix }}_t *section, uint32_t length) {
	{{ type.name }} x1 = section->x1, x2 = section->x2;
	{{ type.name }} y1 = section->y1, y2 = section->y2;

	for (uint32_t c = 0; c < length; c++) {
		{{ type.name }} x0 = data_in[c];
		{{ type.name }} acc = ({{ type.name }})0;

		acc = acc + (section->b[0] * x0);
		acc = acc + (section->b[1] * x1);
		acc = acc + (section->b[2] * x2);
		acc = acc - (section->a[1] * y1);
		acc = acc - (section->a[2] * y2);
		acc = acc / section->a[0];

		x2 = x1;
		x1 = x0;
		y2 = y1;
		y1 = acc;
		data_out[c] = acc;
	}
	section->x1 = x1;
	section->x2 = x2;
	section->y1 = y1;
	section->y2 = y2;
}

void sos_filter_{{ type.suffix }}({{ type.name }} *data_in, {{ type.name }} *data_out, struct sos_filter_{{ type.suffix }}_t *filter,
				uint32_t length) {
	if (filter->num_sections == 0) {
		for (uint32_t j = 0; j < length; j++) {
			data_out[j] = data_in[j];
		}
	} else {
		/* The first section reads from the input, the rest then run in place
		 * on the output buffer */
		biquad_section_filter_{{ type.suffix }}(data_in, data_out, &filter->biquad_section[0],
							  length);
		for (uint32_t i = 1; i < filter->num_sections; i++) {
			biquad_section_filter_{{ type.suffix }}(data_out, data_out,
								  &filter->biquad_section[i], length);
		}
	}

	for (uint32_t j = 0; j < length; j++) {
		data_out[j] = filter->gain * data_out[j];
	}
}
