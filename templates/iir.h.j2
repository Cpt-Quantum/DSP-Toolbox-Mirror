#ifndef IIR_{{ type.suffix | upper }}_H
#define IIR_{{ type.suffix | upper }}_H

#ifdef __cplusplus
extern "C" {
#endif

#include <stdint.h>

#include "filter_shared.h"

{% if type.fixed_point -%}
/* The coefficients are in Q format with frac_bits fractional bits, as for the
 * FIR filter in fir_{{ type.suffix }}.h. They must be normalised so a[0] is 1.0, i.e.
 * 1 << frac_bits, as the shift back down by frac_bits takes the place of the
 * division by a[0] and a[0] is not read. The feedforward and feedback terms
 * are summed together in {{ type.acc_type }}, and each output is only rounded
{%- if type.limits %}
 * and saturated once
{%- else %}
 * once
{%- endif %}, after the sum. The same applies to each biquad section, and
 * the SOS gain is also in Q format with frac_bits fractional bits */
{% endif -%}
struct iir_{{ type.suffix }}_t {
	{{ type.name }} *a;
	{{ type.name }} *b;
	/* Input and output histories, FILTER_STATE_SIZE(taps) elements each */
	{{ type.name }} *in_buff, *out_buff;
	uint16_t taps;
{%- if type.fixed_point %}
	/* Fractional bits of the coefficients, at most {{ 30 if type.limits else 62 }} so 1.0 can be
	 * represented */
	uint8_t frac_bits;
{%- endif %}
};

/* Definitions for IIR filters in biquad/second order sections format */
struct biquad_section_{{ type.suffix }}_t {
	{{ type.name }} a[3], b[3];
	/* Previous two inputs x[n-1], x[n-2] and outputs y[n-1], y[n-2] */
	{{ type.name }} x1, x2, y1, y2;
};
struct sos_filter_{{ type.suffix }}_t {
	struct biquad_section_{{ type.suffix }}_t *biquad_section;
	uint16_t num_sections;
{%- if type.fixed_point %}
	/* Fractional bits of the section coefficients and the gain, at most {{ 30 if type.limits else 62 }}
	 * so 1.0 can be represented */
	uint8_t frac_bits;
{%- endif %}
	{{ type.name }} gain;
};

void iir_filter_{{ type.suffix }}({{ type.name }} *data_in, {{ type.name }} *data_out, struct iir_{{ type.suffix }}_t *filter,
				uint32_t length);
void sos_filter_{{ type.suffix }}({{ type.name }} *data_in, {{ type.name }} *data_out,
				struct sos_filter_{{ type.suffix }}_t *sos_filter, uint32_t length);

#ifdef __cplusplus
}
#endif

#endif /* IIR_{{ type.suffix | upper }}_H */
