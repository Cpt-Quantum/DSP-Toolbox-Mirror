#include "../cjson/cJSON.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "fir_{{ type.suffix }}.h"
#include "iir_{{ type.suffix }}.h"

{% if type.fixed_point -%}
/* Fractional bits of the Q format coefficients, written by the Python filter
 * design scripts when the coefficients are quantised. Returns 0 (integer
 * coefficients) if it is missing or above max. The IIR filters need 1.0 to be
 * representable for a[0], so allow one less fractional bit than the FIR */
static uint8_t get_frac_bits_{{ type.suffix }}(cJSON *node, int max) {
	cJSON *frac_bits = cJSON_GetObjectItem(node, "frac_bits");
	if (!cJSON_IsNumber(frac_bits)) {
		printf("Warning: 'frac_bits' not found, the coefficients are treated "
			   "as integers. Quantise them with fixed_point_format in the "
			   "filter design.\n");
		return 0;
	}
	if (frac_bits->valueint < 0 || frac_bits->valueint > max) {
		printf("Error: 'frac_bits' (%d) must be from 0 to %d, using 0.\n",
			   frac_bits->valueint, max);
		return 0;
	}
	return (uint8_t)frac_bits->valueint;
}

/* The filters don't divide by a[0], so it must be 1.0 in Q format */
static void check_a0_{{ type.suffix }}({{ type.name }} a0, uint8_t frac_bits) {
	if (a0 != ({{ type.name }})1 << frac_bits) {
		printf("Warning: a[0] is %lld but must be 1 << frac_bits (%lld), the "
			   "coefficients should be normalised by a[0].\n",
			   (long long)a0, (long long)(({{ type.name }})1 << frac_bits));
	}
}

{% endif -%}
{{ type.name }} get_sample_rate_from_json_{{ type.suffix }}(cJSON *f_s_node) {
	{{ type.name }} f_s = ({{ type.name }})0.0{{ type.literal_suffix }};
	if (cJSON_IsNumber(f_s_node)) {
		f_s = ({{ type.name }})f_s_node->valuedouble;
		printf("Loaded sample rate: %.1f Hz\n", (double)f_s);
	} else {
		printf("Warning: 'f_s' not found or invalid. Defaulting to 16kHz\n");
		f_s = ({{ type.name }})16000.0{{ type.literal_suffix }};
	}
	return f_s;
}

void init_fir_from_json_{{ type.suffix }}(struct fir_{{ type.suffix }}_t *filt, cJSON *fir_node) {
	/* Check if the passed object is valid */
	if (!cJSON_IsObject(fir_node)) {
		printf("Error: Invalid FIR JSON node.\n");
		return;
	}
	/* Parse the B coefficients */
	cJSON *b_cjson = cJSON_GetObjectItem(fir_node, "b");
	if (!cJSON_IsArray(b_cjson))
		return;
	/* Get the number of filter coefficients and initialise the decimation
	 * phase */
	filt->taps = (uint16_t)cJSON_GetArraySize(b_cjson);
	filt->decimation_phase = 0;
{%- if type.fixed_point %}
	filt->frac_bits = get_frac_bits_{{ type.suffix }}(fir_node, {{ 31 if type.limits else 62 }});
{%- endif %}
	/* Allocate memory for the B coefficients and the lookback buffer */
	filt->b = ({{ type.name }} *)malloc(filt->taps * sizeof({{ type.name }}));
	filt->in_buff = ({{ type.name }} *)calloc(FILTER_STATE_SIZE(filt->taps), sizeof({{ type.name }}));
	/* Now use the parsed B coefficients into the C structure */
	for (int i = 0; i < filt->taps; i++) {
		cJSON *b_coeff = cJSON_GetArrayItem(b_cjson, i);
		if (cJSON_IsNumber(b_coeff)) {
			filt->b[i] = ({{ type.name }})b_coeff->valuedouble;
		}
	}
	printf("Loaded an FIR filter from the input JSON file.\n");
}

void init_iir_from_json_{{ type.suffix }}(struct iir_{{ type.suffix }}_t *filt, cJSON *iir_node) {
	/* Check if the passed object is valid */
	if (!cJSON_IsObject(iir_node)) {
		printf("Error: Invalid IIR JSON node.\n");
		return;
	}
	/* Parse the A & B coefficients */
	cJSON *a_cjson = cJSON_GetObjectItem(iir_node, "a");
	cJSON *b_cjson = cJSON_GetObjectItem(iir_node, "b");
	/* Validate that both sets of coefficients were found */
	if (!cJSON_IsArray(b_cjson) || !cJSON_IsArray(a_cjson)) {
		printf("Error: IIR filter JSON missing 'a' or 'b' arrays.\n");
		return;
	}
	/* Check the same number of coefficients were parsed for A & B */
	int b_taps = cJSON_GetArraySize(b_cjson);
	int a_taps = cJSON_GetArraySize(a_cjson);
	if (b_taps != a_taps) {
		printf("Warning: 'a' (%d) and 'b' (%d) array lengths differ! Using the "
			   "smaller size.\n",
			   a_taps, b_taps);
	}
	/* Use the smaller number of coefficients if there was a mismatch, this
	 * should never happen but this stops any error from causing issue
	 * downstream in the filter logic. */
	filt->taps = (uint16_t)(b_taps < a_taps ? b_taps : a_taps);
	/* Allocate the memory for the coefficient arrays */
	filt->b = ({{ type.name }} *)malloc(filt->taps * sizeof({{ type.name }}));
	filt->a = ({{ type.name }} *)malloc(filt->taps * sizeof({{ type.name }}));
	/* Allocate (and zero) buffers for the lookback/feedback buffers */
	filt->in_buff = ({{ type.name }} *)calloc(FILTER_STATE_SIZE(filt->taps), sizeof({{ type.name }}));
	filt->out_buff = ({{ type.name }} *)calloc(FILTER_STATE_SIZE(filt->taps), sizeof({{ type.name }}));
	/* Now use the parsed coefficients to set the C struct arrays */
	for (int i = 0; i < filt->taps; i++) {
		cJSON *b_coeff = cJSON_GetArrayItem(b_cjson, i);
		cJSON *a_coeff = cJSON_GetArrayItem(a_cjson, i);
		if (cJSON_IsNumber(b_coeff)) {
			filt->b[i] = ({{ type.name }})b_coeff->valuedouble;
		}
		if (cJSON_IsNumber(a_coeff)) {
			filt->a[i] = ({{ type.name }})a_coeff->valuedouble;
		}
	}
{%- if type.fixed_point %}
	filt->frac_bits = get_frac_bits_{{ type.suffix }}(iir_node, {{ 30 if type.limits else 62 }});
	if (filt->taps > 0) {
		check_a0_{{ type.suffix }}(filt->a[0], filt->frac_bits);
	}
{%- endif %}
	printf("Loaded an IIR filter from the input JSON file.\n");
}

void init_sos_from_json_{{ type.suffix }}(struct sos_filter_{{ type.suffix }}_t *filt, cJSON *sos_node) {
	/* Check if the passed object is valid */
	if (!cJSON_IsObject(sos_node))
		return;
	/* Parse the sections and gain from the JSON object */
	cJSON *sections_arr = cJSON_GetObjectItem(sos_node, "sections");
	cJSON *gain = cJSON_GetObjectItem(sos_node, "gain");
	/* Validate that the second order sections were found */
	if (!cJSON_IsArray(sections_arr))
		return;
	/* Get the number of second order sections and the gain (set the gain to 1
	 * if not present) */
	filt->num_sections = (uint16_t)cJSON_GetArraySize(sections_arr);
{%- if type.fixed_point %}
	filt->frac_bits = get_frac_bits_{{ type.suffix }}(sos_node, {{ 30 if type.limits else 62 }});
	/* A missing gain defaults to 1.0 in Q format */
	filt->gain = cJSON_IsNumber(gain) ? ({{ type.name }})gain->valuedouble : ({{ type.name }})1 << filt->frac_bits;
{%- else %}
	filt->gain = cJSON_IsNumber(gain) ? ({{ type.name }})gain->valuedouble : ({{ type.name }})1.0{{ type.literal_suffix }};
{%- endif %}
	/* Allocate memory for the second order sections */
	filt->biquad_section = (struct biquad_section_{{ type.suffix }}_t *)malloc(
		filt->num_sections * sizeof(struct biquad_section_{{ type.suffix }}_t));
	/* Now parse the JSON second order sections into the C structure */
	for (int i = 0; i < filt->num_sections; i++) {
		cJSON *section_json = cJSON_GetArrayItem(sections_arr, i);
		if (cJSON_IsArray(section_json) &&
			cJSON_GetArraySize(section_json) == 6) {
			struct biquad_section_{{ type.suffix }}_t *section = &filt->biquad_section[i];

			section->b[0] =
				({{ type.name }})cJSON_GetArrayItem(section_json, 0)->valuedouble;
			section->b[1] =
				({{ type.name }})cJSON_GetArrayItem(section_json, 1)->valuedouble;
			section->b[2] =
				({{ type.name }})cJSON_GetArrayItem(section_json, 2)->valuedouble;
			section->a[0] =
				({{ type.name }})cJSON_GetArrayItem(section_json, 3)->valuedouble;
			section->a[1] =
				({{ type.name }})cJSON_GetArrayItem(section_json, 4)->valuedouble;
			section->a[2] =
				({{ type.name }})cJSON_GetArrayItem(section_json, 5)->valuedouble;

{%- if type.fixed_point %}
			check_a0_{{ type.suffix }}(section->a[0], filt->frac_bits);
{%- endif %}

			section->x1 = section->x2 = ({{ type.name }})0;
			section->y1 = section->y2 = ({{ type.name }})0;
		}
	}
	printf("Loaded an SOS filter from the input JSON file.\n");
}

/* Define a collection of free() functions to deal with clearing the malloced
 * arrays */
void free_fir_{{ type.suffix }}(struct fir_{{ type.suffix }}_t *filt) {
	if (filt->b)
		free(filt->b);
	if (filt->in_buff)
		free(filt->in_buff);

	// Nullify pointers for safety
	filt->b = NULL;
	filt->in_buff = NULL;
	filt->taps = 0;
}

void free_iir_{{ type.suffix }}(struct iir_{{ type.suffix }}_t *filt) {
	if (filt->b)
		free(filt->b);
	if (filt->a)
		free(filt->a);
	if (filt->in_buff)
		free(filt->in_buff);
	if (filt->out_buff)
		free(filt->out_buff);

	filt->b = NULL;
	filt->a = NULL;
	filt->in_buff = NULL;
	filt->out_buff = NULL;
	filt->taps = 0;
}

void free_sos_{{ type.suffix }}(struct sos_filter_{{ type.suffix }}_t *filt) {
	if (filt->biquad_section)
		free(filt->biquad_section);

	filt->biquad_section = NULL;
	filt->num_sections = 0;
}
