{% if not fft.table_only -%}
#include <math.h>
{% endif -%}
#include <stdbool.h>
#include <stdint.h>

#include "fft_{{ type.suffix }}.h"
{%- if not fft.table_only %}

/* The sources are also compiled as C++ by the C++ wrapper */
#ifdef __cplusplus
#define ALIGNOF(type) alignof(type)
#else
#define ALIGNOF(type) _Alignof(type)
#endif

#define TWO_PI 6.28318530717958647692

{% if fft.twiddle.math_type != type.name -%}
/* Twiddle factor e^(-j 2 pi k / n), calculated in {{ fft.twiddle.math_type }} and rounded once
 * to {{ type.name }}. The precision is chosen when the sources are generated */
{%- else %}
/* Twiddle factor e^(-j 2 pi k / n), calculated in {{ fft.twiddle.math_type }}. The precision
 * is chosen when the sources are generated */
{%- endif %}
static complex_{{ type.suffix }}_t twiddle_{{ type.suffix }}(uint32_t k, uint32_t n) {
	const {{ fft.twiddle.math_type }} angle = ({{ fft.twiddle.math_type }})TWO_PI * ({{ fft.twiddle.math_type }})k / ({{ fft.twiddle.math_type }})n;
{%- set cast = "(" ~ type.name ~ ")" if fft.twiddle.math_type != type.name else "" %}
	complex_{{ type.suffix }}_t w = {{ "{" }}{{ cast }}cos{{ fft.twiddle.math_suffix }}(angle), {{ cast }}-sin{{ fft.twiddle.math_suffix }}(angle)};
	return w;
}
{%- endif %}
{%- if fft.table %}

/* Twiddle factors e^(-j 2 pi k / {{ fft.table.max_n }}) for k < {{ fft.table.max_n // 2 }}, generated by
 * scripts/generate_sources.py in double precision
{%- if type.name != "double" %} and rounded once to {{ type.name }}{% endif %}.
 * They are filled in the same way as fft_plan_init_{{ type.suffix }}(), so symmetric twiddles
 * match bit for bit. An n point transform uses every ({{ fft.table.max_n }} / n)th entry,
 * which are exactly the n point twiddle factors */
static const complex_{{ type.suffix }}_t twiddle_table_{{ type.suffix }}[{{ fft.table.max_n // 2 }}] = {
{%- for entry in fft.table.entries %}
	{{ entry }},
{%- endfor %}
};
{%- endif %}

/* Reorders x into bit reversed index order. j holds the bit reversal of i,
 * and is advanced by clearing its set bits from the top down until reaching a
 * clear bit, which is then set */
static void bit_reverse_{{ type.suffix }}(complex_{{ type.suffix }}_t *x, uint32_t n) {
	uint32_t j = 0;
	for (uint32_t i = 0; i < n; i++) {
		if (i < j) {
			complex_{{ type.suffix }}_t tmp = x[i];
			x[i] = x[j];
			x[j] = tmp;
		}

		uint32_t bit = n >> 1;
		while (j & bit) {
			j ^= bit;
			bit >>= 1;
		}
		j |= bit;
	}
}

/* Radix-2 butterfly stages over bit reversed input, combining pairs of half
 * point transforms into transforms of twice the length. Twiddle factor k of
 * the n point transform is twiddle[k * stride], and the factors are
 * conjugated for the inverse transform. The loop is driven by half < n rather
 * than 2 * half <= n so it can't overflow for n = 2^31 */
static void radix2_kernel_{{ type.suffix }}(complex_{{ type.suffix }}_t *x, const complex_{{ type.suffix }}_t *twiddle, uint32_t n,
								uint32_t stride, bool conjugate) {
	for (uint32_t half = 1; half < n; half <<= 1) {
		const uint32_t len = 2 * half;
		const uint32_t step = stride * ((n / 2) / half);

		/* Each twiddle factor is loaded once per stage */
		for (uint32_t k = 0; k < half; k++) {
			const {{ type.name }} w_real = twiddle[k * step].real;
			const {{ type.name }} w_imag = conjugate ? -twiddle[k * step].imag : twiddle[k * step].imag;

			for (uint32_t a = k; a < n; a += len) {
				const uint32_t b = a + half;
				const {{ type.name }} t_real = x[b].real * w_real - x[b].imag * w_imag;
				const {{ type.name }} t_imag = x[b].real * w_imag + x[b].imag * w_real;

				x[b].real = x[a].real - t_real;
				x[b].imag = x[a].imag - t_imag;
				x[a].real += t_real;
				x[a].imag += t_imag;
			}
		}
	}
}

static bool valid_size_{{ type.suffix }}(uint32_t n) {
	return n >= 2 && (n & (n - 1)) == 0;
}

static uint32_t log2_{{ type.suffix }}(uint32_t n) {
	uint32_t log2n = 0;
	while ((1u << log2n) < n) {
		log2n++;
	}
	return log2n;
}
{%- if not fft.table_only %}

size_t fft_plan_size_{{ type.suffix }}(uint32_t n) {
	if (!valid_size_{{ type.suffix }}(n)) {
		return 0;
	}
#if SIZE_MAX <= UINT32_MAX
	/* Only possible on 32 bit targets, for large n */
	if (n / 2 > SIZE_MAX / sizeof(complex_{{ type.suffix }}_t)) {
		return 0;
	}
#endif
	return FFT_PLAN_SIZE_{{ type.suffix | upper }}((size_t)n);
}

size_t rfft_plan_size_{{ type.suffix }}(uint32_t n) {
	return fft_plan_size_{{ type.suffix }}(n);
}

/* Validates the arguments of the plan init functions and fills the n point
 * twiddle table into work. Only k <= n / 8 is calculated, the rest are exact
 * reflections of the already rounded values so symmetric twiddles match bit
 * for bit. Filling in increasing k means each reflection reads a value
 * already written */
static FFT_STATUS_E fill_twiddles_{{ type.suffix }}(const void *plan, uint32_t n, void *work, size_t work_bytes) {
	if (plan == NULL || work == NULL) {
		return FFT_ERR_NULL_POINTER;
	}

	const size_t required = fft_plan_size_{{ type.suffix }}(n);
	if (required == 0) {
		return FFT_ERR_INVALID_SIZE;
	}
	if (work_bytes < required) {
		return FFT_ERR_WORK_TOO_SMALL;
	}
	if ((uintptr_t)work % ALIGNOF(complex_{{ type.suffix }}_t) != 0) {
		return FFT_ERR_WORK_MISALIGNED;
	}

	complex_{{ type.suffix }}_t *twiddle = (complex_{{ type.suffix }}_t *)work;
	const uint32_t half = n / 2;
	const uint32_t quarter = n / 4;
	for (uint32_t k = 0; k < half; k++) {
		if (k <= n / 8) {
			twiddle[k] = twiddle_{{ type.suffix }}(k, n);
		} else if (k <= quarter) {
			twiddle[k].real = -twiddle[quarter - k].imag;
			twiddle[k].imag = -twiddle[quarter - k].real;
		} else {
			twiddle[k].real = -twiddle[half - k].real;
			twiddle[k].imag = twiddle[half - k].imag;
		}
	}

	return FFT_OK;
}

FFT_STATUS_E fft_plan_init_{{ type.suffix }}(struct fft_plan_{{ type.suffix }}_t *plan, uint32_t n, void *work,
								 size_t work_bytes) {
	const FFT_STATUS_E status = fill_twiddles_{{ type.suffix }}(plan, n, work, work_bytes);
	if (status != FFT_OK) {
		return status;
	}

	plan->n = n;
	plan->log2n = log2_{{ type.suffix }}(n);
	plan->twiddle = (const complex_{{ type.suffix }}_t *)work;
	plan->twiddle_stride = 1;

	return FFT_OK;
}

FFT_STATUS_E rfft_plan_init_{{ type.suffix }}(struct rfft_plan_{{ type.suffix }}_t *plan, uint32_t n, void *work,
								  size_t work_bytes) {
	const FFT_STATUS_E status = fill_twiddles_{{ type.suffix }}(plan, n, work, work_bytes);
	if (status != FFT_OK) {
		return status;
	}

	plan->n = n;
	plan->twiddle = (const complex_{{ type.suffix }}_t *)work;
	plan->twiddle_stride = 1;

	return FFT_OK;
}
{%- endif %}
{%- if fft.table %}

FFT_STATUS_E fft_plan_init_table_{{ type.suffix }}(struct fft_plan_{{ type.suffix }}_t *plan, uint32_t n) {
	if (plan == NULL) {
		return FFT_ERR_NULL_POINTER;
	}
	if (!valid_size_{{ type.suffix }}(n) || n > FFT_TABLE_MAX_N_{{ type.suffix | upper }}) {
		return FFT_ERR_INVALID_SIZE;
	}

	plan->n = n;
	plan->log2n = log2_{{ type.suffix }}(n);
	plan->twiddle = twiddle_table_{{ type.suffix }};
	plan->twiddle_stride = FFT_TABLE_MAX_N_{{ type.suffix | upper }} / n;

	return FFT_OK;
}

FFT_STATUS_E rfft_plan_init_table_{{ type.suffix }}(struct rfft_plan_{{ type.suffix }}_t *plan, uint32_t n) {
	if (plan == NULL) {
		return FFT_ERR_NULL_POINTER;
	}
	if (!valid_size_{{ type.suffix }}(n) || n > FFT_TABLE_MAX_N_{{ type.suffix | upper }}) {
		return FFT_ERR_INVALID_SIZE;
	}

	plan->n = n;
	plan->twiddle = twiddle_table_{{ type.suffix }};
	plan->twiddle_stride = FFT_TABLE_MAX_N_{{ type.suffix | upper }} / n;

	return FFT_OK;
}
{%- endif %}

void fft_{{ type.suffix }}(const struct fft_plan_{{ type.suffix }}_t *plan, complex_{{ type.suffix }}_t *x) {
	bit_reverse_{{ type.suffix }}(x, plan->n);
	radix2_kernel_{{ type.suffix }}(x, plan->twiddle, plan->n, plan->twiddle_stride, false);
}

void ifft_{{ type.suffix }}(const struct fft_plan_{{ type.suffix }}_t *plan, complex_{{ type.suffix }}_t *x) {
	bit_reverse_{{ type.suffix }}(x, plan->n);
	radix2_kernel_{{ type.suffix }}(x, plan->twiddle, plan->n, plan->twiddle_stride, true);

	/* Exact, since n is a power of two */
	const {{ type.name }} scale = 1.0{{ type.literal_suffix }} / ({{ type.name }})plan->n;
	for (uint32_t i = 0; i < plan->n; i++) {
		x[i].real *= scale;
		x[i].imag *= scale;
	}
}

/* The real transforms pack the n samples into m = n / 2 complex values,
 * z[i] = x[2i] + j x[2i + 1], and transform them with an m point FFT, which
 * uses every second n point twiddle factor. Z[k] then holds the transforms of
 * the even samples, E[k], and of the odd samples, O[k]:
 *	E[k] = (Z[k] + conj(Z[m - k])) / 2
 *	O[k] = (Z[k] - conj(Z[m - k])) / 2j
 * and the bins of the n point transform are
 *	X[k] = E[k] + W^k O[k]
 *	X[m - k] = conj(E[k] - W^k O[k])
 * with W^k = e^(-j 2 pi k / n). Bins k and m - k are calculated together,
 * so each pair uses one twiddle factor */
void rfft_{{ type.suffix }}(const struct rfft_plan_{{ type.suffix }}_t *plan, {{ type.name }} *x) {
	complex_{{ type.suffix }}_t *z = (complex_{{ type.suffix }}_t *)x;
	const uint32_t m = plan->n / 2;
	const uint32_t stride = plan->twiddle_stride;

	bit_reverse_{{ type.suffix }}(z, m);
	radix2_kernel_{{ type.suffix }}(z, plan->twiddle, m, 2 * stride, false);

	/* Bins 0 and m are real, E[0] + O[0] and E[0] - O[0] */
	const {{ type.name }} z0_real = z[0].real;
	z[0].real = z0_real + z[0].imag;
	z[0].imag = z0_real - z[0].imag;

	for (uint32_t k = 1; k < m - k; k++) {
		const uint32_t mk = m - k;
		const {{ type.name }} w_real = plan->twiddle[k * stride].real;
		const {{ type.name }} w_imag = plan->twiddle[k * stride].imag;

		const {{ type.name }} e_real = 0.5{{ type.literal_suffix }} * (z[k].real + z[mk].real);
		const {{ type.name }} e_imag = 0.5{{ type.literal_suffix }} * (z[k].imag - z[mk].imag);
		const {{ type.name }} o_real = 0.5{{ type.literal_suffix }} * (z[k].imag + z[mk].imag);
		const {{ type.name }} o_imag = 0.5{{ type.literal_suffix }} * (z[mk].real - z[k].real);
		const {{ type.name }} t_real = o_real * w_real - o_imag * w_imag;
		const {{ type.name }} t_imag = o_real * w_imag + o_imag * w_real;

		z[k].real = e_real + t_real;
		z[k].imag = e_imag + t_imag;
		z[mk].real = e_real - t_real;
		z[mk].imag = t_imag - e_imag;
	}

	/* Bin m / 2 pairs with itself, and works out as conj(Z[m / 2]) */
	if (m >= 2) {
		z[m / 2].imag = -z[m / 2].imag;
	}
}

/* Reverses rfft_{{ type.suffix }}(), recovering Z[k] = E[k] + j O[k] from
 *	E[k] = (X[k] + conj(X[m - k])) / 2
 *	O[k] = (X[k] - conj(X[m - k])) conj(W^k) / 2
 * then running an m point inverse FFT. The halves are left out here and
 * folded into the final 1 / n scale */
void irfft_{{ type.suffix }}(const struct rfft_plan_{{ type.suffix }}_t *plan, {{ type.name }} *x) {
	complex_{{ type.suffix }}_t *z = (complex_{{ type.suffix }}_t *)x;
	const uint32_t m = plan->n / 2;
	const uint32_t stride = plan->twiddle_stride;

	/* Bins 0 and m are packed into z[0] */
	const {{ type.name }} x0 = z[0].real;
	z[0].real = x0 + z[0].imag;
	z[0].imag = x0 - z[0].imag;

	for (uint32_t k = 1; k < m - k; k++) {
		const uint32_t mk = m - k;
		const {{ type.name }} w_real = plan->twiddle[k * stride].real;
		const {{ type.name }} w_imag = plan->twiddle[k * stride].imag;

		const {{ type.name }} e_real = z[k].real + z[mk].real;
		const {{ type.name }} e_imag = z[k].imag - z[mk].imag;
		const {{ type.name }} d_real = z[k].real - z[mk].real;
		const {{ type.name }} d_imag = z[k].imag + z[mk].imag;
		const {{ type.name }} o_real = d_real * w_real + d_imag * w_imag;
		const {{ type.name }} o_imag = d_imag * w_real - d_real * w_imag;

		z[k].real = e_real - o_imag;
		z[k].imag = e_imag + o_real;
		z[mk].real = e_real + o_imag;
		z[mk].imag = o_real - e_imag;
	}

	if (m >= 2) {
		z[m / 2].real = 2 * z[m / 2].real;
		z[m / 2].imag = -2 * z[m / 2].imag;
	}

	bit_reverse_{{ type.suffix }}(z, m);
	radix2_kernel_{{ type.suffix }}(z, plan->twiddle, m, 2 * stride, true);

	/* Exact, since n is a power of two */
	const {{ type.name }} scale = 1.0{{ type.literal_suffix }} / ({{ type.name }})plan->n;
	for (uint32_t i = 0; i < m; i++) {
		z[i].real *= scale;
		z[i].imag *= scale;
	}
}
{%- if not fft.table_only %}

void dft_{{ type.suffix }}(const complex_{{ type.suffix }}_t *data_in, complex_{{ type.suffix }}_t *data_out, uint32_t n) {
	for (uint32_t i = 0; i < n; i++) {
		{{ type.name }} real = 0;
		{{ type.name }} imag = 0;

		for (uint32_t j = 0; j < n; j++) {
			/* Reduce i * j to one period first, otherwise the angle loses
			 * precision for large transforms */
			const uint32_t k = (uint32_t)(((uint64_t)i * j) % n);
			const {{ type.name }} exponent = (({{ type.name }})TWO_PI / ({{ type.name }})n) * ({{ type.name }})k;
			/* Calculate the cos (c) and sin (s) parts ahead of use */
			const {{ type.name }} c = cos{{ type.math_suffix }}(exponent);
			const {{ type.name }} s = sin{{ type.math_suffix }}(exponent);

			real += data_in[j].real * c + data_in[j].imag * s;
			imag += data_in[j].imag * c - data_in[j].real * s;
		}

		data_out[i].real = real;
		data_out[i].imag = imag;
	}
}
{%- endif %}
